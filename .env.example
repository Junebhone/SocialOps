# --- core ---
DATABASE_URL=postgresql+asyncpg://socialops:socialops@postgres:5432/socialops
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage

# --- LLM (Phase 1 default: free local models via Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_FAST=qwen3.5:2b
LLM_MODEL_TEXT=qwen3.5:9b
LLM_MODEL_VISION=qwen3.5:9b

# --- alternative providers (leave blank in dev) ---
# LLM_PROVIDER=gemini      GEMINI_API_KEY=
# LLM_PROVIDER=azure       AZURE_API_KEY=  AZURE_API_BASE=  AZURE_API_VERSION=
# LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=
# LLM_PROVIDER=bedrock     AWS_REGION=us-east-1  (uses ambient AWS creds)

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
